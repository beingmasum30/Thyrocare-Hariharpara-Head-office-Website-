rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection: Patients can create bookings & read their own, staff/admin can read & update
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Products collection: Public read access for catalogue, staff/admin write access
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection: Registered patient user accounts authorized via Gmail OTP
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'email', 'is_verified', 'created_at'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 200
                            && request.resource.data.email is string
                            && request.resource.data.email.size() <= 200
                            && request.resource.data.is_verified == true;
      allow delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
